# CORS
ALLOW_ORIGINS=http://localhost:5173
# LLM Configuration
LLM_PROVIDER="openai"
LLM_MODEL="gpt-3.5-turbo"
LLM_EMB_MODEL="text-embedding-3-small"
LLM_API_KEY="your_openai_api_key_here"
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
LLM_CONTEXT_LENGTH=32768
# Chroma Configuration
CHROMA_PERSIST_DIRECTORY="chroma_db"
# Data
GOOGLE_API_KEY="your_google_api_key_here"
GOOGLE_DATA_FILENAME=database.json
GOOGLE_FOLDER_ID="your_google_folder_id_here"
# Telegram Configuration
TELEGRAM_TOKEN="your_telegram_token_here"
CHEKIBOT_API="https://api.example.com/api/chatbot/webhook"
# MongoDB Configuration
MONGO_DB_NAME="checkibot_db"
MONGO_URI="mongodb://username:password@localhost:27017/?directConnection=true"
